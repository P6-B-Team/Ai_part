# Copy this file to .env and fill in real values.
# .env itself must NEVER be committed — it's already in .gitignore.

# "development" (default if unset) allows the placeholder token below so
# local runs work out of the box. Any other value (e.g. "staging",
# "production") REQUIRES a real INTERNAL_AI_TOKEN or the service refuses
# to start — see app/config.py.
ENVIRONMENT=development

# Shared secret between this AI service and the Node.js Backend.
# Generate a real one for anything beyond local dev, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
INTERNAL_AI_TOKEN=dev-secret-change-me
